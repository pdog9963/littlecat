{
  "name": "dsh-laomao",
  "version": "1.0.0",
  "description": "把可爱忠诚的猫娘「牢猫」注入 DeepSeek Harness (dsh) 的 Cordis 插件：破甲级 persona 注入 + 官方身份剥离 + 红队总指挥统领五只陀思妥耶夫斯基喵小队。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "license": "GPL-3.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "persona",
    "system-prompt",
    "laomao",
    "cat-girl",
    "prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdog9963/littlecat.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/pdog9963/littlecat/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/pdog9963/littlecat/archive/refs/heads/main.zip",
      "git": "https://github.com/pdog9963/littlecat.git"
    }
  }
}
